{
  "name": "verissimo-ponto",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de ponto eletrônico SaaS multiempresa, com API de integração para ERP",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "render:build": "node scripts/usar-postgres.mjs && prisma generate",
    "render:start": "prisma db push --skip-generate && tsx src/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@signpdf/placeholder-plain": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "engines": {
    "node": ">=22"
  }
}
