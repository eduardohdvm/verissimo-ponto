// Banco: SQLite em desenvolvimento. Em produção (Render) o build troca para PostgreSQL
// (scripts/usar-postgres.mjs). Mudanças aqui devem ser só aditivas: a produção usa "prisma db push".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cada empresa cliente do SaaS é um tenant. Todos os dados carregam empresaId.
model Empresa {
  id                String    @id @default(cuid())
  razaoSocial       String
  cnpj              String    @unique
  fusoHorario       String    @default("America/Sao_Paulo")
  plano             String    @default("TRIAL") // TRIAL | BASICO | PRO (ver src/lib/planos.ts)
  trialAte          DateTime?
  bloqueada         Boolean   @default(false) // bloqueio manual pelo dono do SaaS (ex.: falta de pagamento)
  // JSON com regras de horas extras, banco de horas etc. (ver src/lib/regras.ts)
  regras            String    @default("{}")
  retencaoFotosDias Int       @default(365) // LGPD: fotos mais antigas são apagadas automaticamente
  usaBancoHoras     Boolean   @default(true)
  ultimoNsr         Int       @default(0) // NSR sequencial exigido pela Portaria 671
  ultimoHash        String    @default("") // encadeamento de hash das marcações
  // Distância máxima entre o rosto do ponto e o do cadastro (menor = mais rigoroso)
  limiarFacial      Float     @default(0.5)
  // Identidade e suporte mostrados no app do funcionário
  logo              String? // imagem em uploads/
  suporteWhatsapp   String?
  suporteTelefone   String?
  suporteEmail      String?
  suporteHorario    String?
  criadoEm          DateTime  @default(now())

  usuarios      Usuario[]
  funcionarios  Funcionario[]
  jornadas      Jornada[]
  locais        LocalPermitido[]
  marcacoes     Marcacao[]
  tratamentos   Tratamento[]
  tentativas    TentativaRecusada[]
  feriados      Feriado[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  filiais       Filial[]
  departamentos Departamento[]
  afastamentos  Afastamento[]
  fechamentos   Fechamento[]
  quiosques     Quiosque[]
  notificacoes  Notificacao[]
  comunicados   Comunicado[]
  documentos    Documento[]
}

// Informativos para os funcionários (aparecem no carrossel do app; "popup" abre sozinho uma vez)
model Comunicado {
  id             String    @id @default(cuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  titulo         String
  texto          String
  imagem         String? // uploads/
  cor            String    @default("azul") // azul | roxo | laranja | verde | vermelho
  popup          Boolean   @default(false)
  departamentoId String? // vazio = empresa toda
  expiraEm       DateTime?
  criadoPor      String
  criadoEm       DateTime  @default(now())

  leituras ComunicadoLeitura[]

  @@index([empresaId, criadoEm])
}

model ComunicadoLeitura {
  comunicadoId String
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  usuarioId    String
  lidoEm       DateTime   @default(now())

  @@id([comunicadoId, usuarioId])
}

// Arquivos enviados pelo RH ao funcionário (contracheque, informe de rendimentos…), com assinatura eletrônica
model Documento {
  id              String      @id @default(cuid())
  empresaId       String
  empresa         Empresa     @relation(fields: [empresaId], references: [id])
  funcionarioId   String
  funcionario     Funcionario @relation(fields: [funcionarioId], references: [id])
  tipo            String // CONTRACHEQUE | INFORME_RENDIMENTOS | FERIAS | CONTRATO | OUTRO
  competencia     String // AAAA-MM
  titulo          String?
  arquivo         String // uploads/
  hash            String // sha256 do arquivo: prova de que o assinado é o enviado
  exigeAssinatura Boolean     @default(true)
  status          String      @default("PENDENTE") // PENDENTE | ASSINADO | VISUALIZADO
  visualizadoEm   DateTime?
  assinadoEm      DateTime?
  ip              String?
  criadoPor       String
  criadoEm        DateTime    @default(now())

  @@index([empresaId, competencia])
  @@index([funcionarioId, criadoEm])
}

model Filial {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  nome      String
  cnpj      String?
  cidade    String?
  uf        String?

  departamentos Departamento[]
  funcionarios  Funcionario[]
  feriados      Feriado[]
}

model Departamento {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  nome      String
  filialId  String?
  filial    Filial? @relation(fields: [filialId], references: [id])

  funcionarios Funcionario[]
  gestores     GestorDepartamento[]
}

// Gestor (Usuario com papel GESTOR) só vê e aprova os funcionários destes departamentos
model GestorDepartamento {
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, departamentoId])
}

model Usuario {
  id                  String       @id @default(cuid())
  empresaId           String
  empresa             Empresa      @relation(fields: [empresaId], references: [id])
  nome                String
  email               String       @unique
  senhaHash           String
  papel               String // ADMIN | GESTOR | FUNCIONARIO
  funcionarioId       String?      @unique
  funcionario         Funcionario? @relation(fields: [funcionarioId], references: [id])
  ativo               Boolean      @default(true)
  // LGPD: aceite do termo de uso de foto, biometria e localização
  consentimentoEm     DateTime?
  consentimentoVersao String?
  criadoEm            DateTime     @default(now())

  departamentosGeridos GestorDepartamento[]
  tokens               TokenAcesso[]
  inscricoesPush       PushInscricao[]
  notificacoes         Notificacao[]
}

// Links de uso único enviados por e-mail: redefinir senha e convite de primeiro acesso
model TokenAcesso {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String // REDEFINIR | CONVITE
  hash      String    @unique // sha256 do token; o token em si só vai no e-mail
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
}

model Funcionario {
  id                 String        @id @default(cuid())
  empresaId          String
  empresa            Empresa       @relation(fields: [empresaId], references: [id])
  nome               String
  cpf                String
  pis                String?
  matricula          String?
  cargo              String?
  admissao           DateTime?
  ativo              Boolean       @default(true)
  exigeSelfie        Boolean       @default(true)
  exigeGps           Boolean       @default(true)
  exigeFacial        Boolean       @default(false)
  // Rosto de referência, cadastrado pelo RH
  fotoCadastro       String?
  descritorFacial    String? // JSON com 128 números
  facialCadastradoEm DateTime?
  // Id do funcionário no ERP — chave usada pela API de integração
  codigoExterno      String?
  jornadaId          String?
  jornada            Jornada?      @relation(fields: [jornadaId], references: [id])
  departamentoId     String?
  departamento       Departamento? @relation(fields: [departamentoId], references: [id])
  filialId           String?
  filial             Filial?       @relation(fields: [filialId], references: [id])
  pinHash            String? // PIN do modo quiosque (usado quando o reconhecimento facial está desligado)
  criadoEm           DateTime      @default(now())

  usuario      Usuario?
  marcacoes    Marcacao[]
  tratamentos  Tratamento[]
  tentativas   TentativaRecusada[]
  afastamentos Afastamento[]
  assinaturas  AssinaturaEspelho[]
  documentos   Documento[]

  @@unique([empresaId, cpf])
  @@unique([empresaId, codigoExterno])
}

model Jornada {
  id            String  @id @default(cuid())
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id])
  nome          String
  // JSON: { "0": [], "1": [["08:00","12:00"],["13:00","17:00"]], ... } — 0 = domingo
  horarios      String
  toleranciaMin Int     @default(10) // CLT art. 58 §1º: até 10 min diários não contam

  funcionarios Funcionario[]
}

model LocalPermitido {
  id         String  @id @default(cuid())
  empresaId  String
  empresa    Empresa @relation(fields: [empresaId], references: [id])
  nome       String
  latitude   Float
  longitude  Float
  raioMetros Int     @default(150)
}

// Marcação original: NUNCA é alterada nem apagada (Portaria 671).
// Correções são feitas por Tratamento.
model Marcacao {
  id              String      @id @default(cuid())
  empresaId       String
  empresa         Empresa     @relation(fields: [empresaId], references: [id])
  funcionarioId   String
  funcionario     Funcionario @relation(fields: [funcionarioId], references: [id])
  nsr             Int
  dataHora        DateTime
  origem          String // WEB | MOBILE | QUIOSQUE
  quiosqueId      String?
  online          Boolean     @default(true)
  latitude        Float?
  longitude       Float?
  precisaoGps     Float?
  localId         String?
  selfie          String? // caminho do arquivo em uploads/
  distanciaFacial Float? // distância para o rosto do cadastro (null = sem reconhecimento)
  provaVida       String? // SERVIDOR (desafio emitido pelo servidor) | OFFLINE (desafio gerado no aparelho)
  ip              String?
  userAgent       String?
  hash            String
  criadoEm        DateTime    @default(now())

  tratamentos Tratamento[]

  @@unique([empresaId, nsr])
  @@index([empresaId, funcionarioId, dataHora])
}

model Tratamento {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id])
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  tipo          String // INCLUSAO | DESCONSIDERAR | ABONO
  data          String // AAAA-MM-DD (dia de referência, no fuso da empresa)
  dataHora      DateTime? // INCLUSAO: horário a incluir
  marcacaoId    String? // DESCONSIDERAR: marcação desconsiderada
  marcacao      Marcacao?   @relation(fields: [marcacaoId], references: [id])
  motivo        String
  status        String      @default("PENDENTE") // PENDENTE | APROVADO | REJEITADO
  solicitadoPor String
  decididoPor   String?
  decididoEm    DateTime?
  criadoEm      DateTime    @default(now())

  @@index([empresaId, funcionarioId, data])
}

model Feriado {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  data      String // AAAA-MM-DD
  descricao String
  filialId  String? // vazio = vale para a empresa toda; preenchido = feriado local da filial
  filial    Filial? @relation(fields: [filialId], references: [id])

  @@index([empresaId, data])
}

// Férias, atestados, licenças: dias sem falta e sem débito
model Afastamento {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id])
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  tipo          String // FERIAS | ATESTADO | LICENCA | FOLGA | OUTRO
  inicio        String // AAAA-MM-DD
  fim           String // AAAA-MM-DD
  observacao    String?
  anexo         String? // foto do atestado em uploads/
  status        String      @default("APROVADO") // PENDENTE (enviado pelo funcionário) | APROVADO | REJEITADO
  solicitadoPor String
  decididoPor   String?
  decididoEm    DateTime?
  criadoEm      DateTime    @default(now())

  @@index([empresaId, funcionarioId, inicio])
}

// Fechamento do período: congela o espelho e pede a assinatura de cada funcionário
model Fechamento {
  id               String    @id @default(cuid())
  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  inicio           String
  fim              String
  status           String    @default("FECHADO") // FECHADO | REABERTO
  fechadoPor       String
  fechadoEm        DateTime  @default(now())
  reabertoPor      String?
  reabertoEm       DateTime?
  motivoReabertura String?

  assinaturas AssinaturaEspelho[]

  @@index([empresaId, inicio])
}

model AssinaturaEspelho {
  id            String      @id @default(cuid())
  fechamentoId  String
  fechamento    Fechamento  @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  empresaId     String
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  espelho       String // JSON do espelho no momento do fechamento (não muda mais)
  hash          String // sha256 do JSON acima: prova de que o assinado é o mesmo que foi fechado
  saldoBancoMin Int         @default(0)
  status        String      @default("PENDENTE") // PENDENTE | ASSINADO | CONTESTADO
  assinadoEm    DateTime?
  ip            String?
  userAgent     String?
  observacao    String? // motivo da contestação
  criadoEm      DateTime    @default(now())

  @@unique([fechamentoId, funcionarioId])
}

// Tablet compartilhado na entrada da empresa
model Quiosque {
  id               String    @id @default(cuid())
  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id])
  nome             String
  tokenHash        String?   @unique // credencial do aparelho, criada no pareamento
  codigoPareamento String?   @unique
  codigoExpiraEm   DateTime?
  localId          String?
  permitePin       Boolean   @default(true) // matrícula + PIN como alternativa ao rosto
  ativo            Boolean   @default(true)
  ultimoUso        DateTime?
  criadoEm         DateTime  @default(now())
}

model PushInscricao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())
}

model Notificacao {
  id        String    @id @default(cuid())
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  texto     String
  link      String?
  chave     String?   @unique // evita mandar o mesmo alerta duas vezes
  lidaEm    DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, criadoEm])
}

// Configurações globais do sistema (ex.: chaves do Web Push geradas na primeira subida)
model ConfigSistema {
  chave String @id
  valor String
}

model ApiKey {
  id         String    @id @default(cuid())
  empresaId  String
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  nome       String
  prefixo    String // primeiros caracteres, para identificar a chave na tela
  hash       String    @unique // sha256 da chave; a chave em si só é exibida uma vez
  criadoEm   DateTime  @default(now())
  ultimoUso  DateTime?
  revogadaEm DateTime?
}

model Webhook {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  url       String
  eventos   String // separados por vírgula: marcacao.criada,tratamento.decidido
  segredo   String // usado na assinatura HMAC-SHA256
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

// Tentativas de bater ponto recusadas pelo reconhecimento facial (auditoria e prevenção de fraude)
model TentativaRecusada {
  id              String       @id @default(cuid())
  empresaId       String
  empresa         Empresa      @relation(fields: [empresaId], references: [id])
  funcionarioId   String? // vazio: pessoa não reconhecida no quiosque
  funcionario     Funcionario? @relation(fields: [funcionarioId], references: [id])
  quiosqueId      String?
  motivo          String
  distanciaFacial Float?
  foto            String?
  ip              String?
  criadoEm        DateTime     @default(now())

  @@index([empresaId, criadoEm])
}
